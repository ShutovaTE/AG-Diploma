@startuml C4 Component Diagram - Spring Web Application

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container(web_browser, "Web Browser", "", "")

System_Boundary(spring_app, "Spring MVC Web Application") {
    
    Component(auth_controller, "AuthController", "Spring MVC", "Аутентификация и авторизация пользователей")
    Component(artwork_controller, "ArtworkController", "Spring MVC", "CRUD операции с произведениями")
    Component(category_controller, "CategoryController", "Spring MVC", "Управление категориями")
    Component(exhibition_controller, "ExhibitionController", "Spring MVC", "Управление выставками")
    Component(admin_controller, "AdminController", "Spring MVC", "Административные функции")
    Component(upload_controller, "UploadController", "Spring MVC", "Загрузка файлов")
    Component(user_controller, "UserController", "Spring MVC", "Управление профилем пользователя")
    Component(home_controller, "HomeController", "Spring MVC", "Домашняя страница и основная навигация")
    Component(recommendation_controller, "RecommendationController", "Spring MVC REST", "API рекомендаций")

    Component(user_service, "UserService", "Service Layer", "Управление пользователями и ролями")
    Component(artwork_service, "ArtworkService", "Service Layer", "Бизнес-логика произведений")
    Component(category_service, "CategoryService", "Service Layer", "Управление категориями")
    Component(exhibition_service, "ExhibitionService", "Service Layer", "Управление выставками")
    Component(moderation_service, "ModerationService", "Service Layer", "Модерирование контента")
    Component(notification_service, "NotificationService", "Service Layer", "Отправка уведомлений")
    Component(image_feature_service, "ImageFeatureService", "Service Layer", "Обработка признаков изображений")
    Component(recommendation_service, "RecommendationService", "Service Layer", "Получение рекомендаций от ML-движка")
    Component(yandex_vision_client, "Yandex Vision Client", "External Service Integration", "Клиент для обращения к Yandex Vision API при модерировании")
    
    ' ----- НОВЫЙ КОМПОНЕНТ -----
    Component(open_clip_service, "OpenClipService", "Service Layer", "Формирование цветовой гистограммы, поиск объектов на изображении, извлечение признаков через OpenCLIP")

    Component(user_repo, "UserRepository", "Data Access", "Доступ к данным пользователей")
    Component(artwork_repo, "ArtworkRepository", "Data Access", "Доступ к данным произведений")
    Component(category_repo, "CategoryRepository", "Data Access", "Доступ к данным категорий")
    Component(exhibition_repo, "ExhibitionRepository", "Data Access", "Доступ к данным выставок")
    Component(comment_repo, "CommentRepository", "Data Access", "Доступ к комментариям")
    Component(like_repo, "LikeRepository", "Data Access", "Доступ к лайкам")
    Component(notification_repo, "NotificationRepository", "Data Access", "Доступ к уведомлениям")
    Component(image_hash_repo, "ImageHashRepository", "Data Access", "Доступ к хешам/признакам изображений")

    Component(user_model, "User, Role", "Model/Entity", "Сущности пользователя и ролей")
    Component(artwork_model, "Artwork, Category", "Model/Entity", "Сущности произведения и категорий")
    Component(exhibition_model, "Exhibition", "Model/Entity", "Сущность выставки")
    Component(interaction_model, "Comment, Like, Notification", "Model/Entity", "Сущности взаимодействия")
    Component(image_model, "ImageHash", "Model/Entity", "Сущность для хранения признаков изображения")

    Component(custom_user_details, "CustomUserDetailsService", "Security", "Сервис аутентификации Spring Security")

    Component(dto_layer, "DTO Objects", "Data Transfer", "RecommendationDTO и другие объекты передачи данных")

    Component(validation_util, "Validation/Utility", "Utils", "Валидация данных и утилиты")

    Component(minio_client, "MinIO Client", "File Storage Integration", "Интеграция с MinIO для управления файлами")

    Component(ml_client, "ML Engine Client", "External Service Integration", "HTTP клиент для обращения к Python ML-сервису")

}

ContainerDb(mysql, "MySQL Database", "", "")

Container_Ext(minio_storage, "MinIO Storage", "", "")

Container_Ext(ml_engine, "ML Recommendation Engine", "", "")

Container_Ext(yandex_vision_api, "Yandex Vision API", "External Image Analysis Service", "")

' ===== СВЯЗИ КОНТРОЛЛЕРОВ =====
Rel(web_browser, home_controller, "HTTP GET /", "")
Rel(web_browser, auth_controller, "HTTP /login /register", "")
Rel(web_browser, artwork_controller, "HTTP /artworks", "")
Rel(web_browser, category_controller, "HTTP /categories", "")
Rel(web_browser, exhibition_controller, "HTTP /exhibitions", "")
Rel(web_browser, user_controller, "HTTP /user", "")
Rel(web_browser, admin_controller, "HTTP /admin", "")
Rel(web_browser, upload_controller, "HTTP POST /upload", "")
Rel(web_browser, recommendation_controller, "HTTP /api/recommendations", "")

' ===== КОНТРОЛЛЕРЫ → СЕРВИСЫ =====
Rel(auth_controller, user_service, "использует")
Rel(auth_controller, custom_user_details, "использует")
Rel(artwork_controller, artwork_service, "использует")
Rel(category_controller, category_service, "использует")
Rel(exhibition_controller, exhibition_service, "использует")
Rel(user_controller, user_service, "использует")
Rel(admin_controller, moderation_service, "использует")
Rel(upload_controller, artwork_service, "использует")
Rel(upload_controller, minio_client, "использует")
Rel(recommendation_controller, recommendation_service, "использует")

' ===== СЕРВИСЫ → ДРУГИЕ СЕРВИСЫ / РЕПОЗИТОРИИ =====
Rel(user_service, user_repo, "использует")
Rel(artwork_service, artwork_repo, "использует")
Rel(artwork_service, image_feature_service, "использует")
Rel(artwork_service, notification_service, "использует")
Rel(artwork_service, open_clip_service, "использует (извлечение признаков при загрузке)")
Rel(category_service, category_repo, "использует")
Rel(exhibition_service, exhibition_repo, "использует")
Rel(moderation_service, artwork_repo, "использует")
Rel(notification_service, notification_repo, "использует")
Rel(image_feature_service, image_hash_repo, "использует")

' ----- НОВЫЕ СВЯЗИ ДЛЯ OpenClipService -----
Rel(recommendation_service, open_clip_service, "использует (получение признаков для рекомендаций)")
Rel(open_clip_service, ml_client, "вызывает ML Engine для сложной обработки")
Rel(open_clip_service, image_hash_repo, "сохраняет/читает гистограммы и признаки")

Rel(recommendation_service, ml_client, "использует (прямой вызов)")
Rel(moderation_service, yandex_vision_client, "использует")

' ===== РЕПОЗИТОРИИ → БАЗА ДАННЫХ =====
Rel(user_repo, mysql, "читает/пишет")
Rel(artwork_repo, mysql, "читает/пишет")
Rel(category_repo, mysql, "читает/пишет")
Rel(exhibition_repo, mysql, "читает/пишет")
Rel(comment_repo, mysql, "читает/пишет")
Rel(like_repo, mysql, "читает/пишет")
Rel(notification_repo, mysql, "читает/пишет")
Rel(image_hash_repo, mysql, "читает/пишет")

' ===== КЛИЕНТЫ ВНЕШНИХ СИСТЕМ =====
Rel(minio_client, minio_storage, "S3-compatible API")
Rel(ml_client, ml_engine, "HTTP JSON запросы")
Rel(yandex_vision_client, yandex_vision_api, "HTTP JSON запросы")

' ===== РЕПОЗИТОРИИ → МОДЕЛИ =====
Rel(user_repo, user_model, "работает с")
Rel(artwork_repo, artwork_model, "работает с")
Rel(exhibition_repo, exhibition_model, "работает с")
Rel(comment_repo, interaction_model, "работает с")
Rel(like_repo, interaction_model, "работает с")
Rel(notification_repo, interaction_model, "работает с")
Rel(image_hash_repo, image_model, "работает с")

@enduml