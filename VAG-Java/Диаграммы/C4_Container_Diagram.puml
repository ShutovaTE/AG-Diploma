@startuml C4 Container Diagram - Virtual Art Gallery

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(visitor, "Посетитель", "Незарегистрированный пользователь")
Person(artist, "Художник", "Авторизованный пользователь")
Person(admin, "Администратор", "Администратор и модератор")

System_Boundary(vag_system, "Информационная система арт-галереи") {
    Container(web_browser, "Web Browser", "HTML5/CSS/JavaScript/Thymeleaf", "Интерфейс пользователя для просмотра галереи, управления произведениями и выставками")
    Container(spring_web, "Spring MVC Web Application", "Spring 5.3.20, Java 11", "Основное приложение с REST API, обработкой бизнес-логики и встроенным модулем модерирования")
    ContainerDb(mysql_db, "MySQL Database", "MySQL 8.0.33", "Хранилище пользователей, произведений, выставок, комментариев, лайков, уведомлений")
    Container(ml_service, "ML Recommendation Service", "Python, OpenCLIP, FastAPI", "Система рекомендаций на основе признаков изображений")
}

System_Ext(minio, "MinIO (S3)", "Объектное хранилище для изображений и NSFW-модели")
System_Ext(yandex_vision_api, "Yandex Cloud Vision API", "Облачный сервис для определения контента 18+")
System_Ext(ml_engine, "ML Recommendation Engine", "Система рекомендаций на основе признаков изображений (OpenCLIP)")

Rel(visitor, web_browser, "просматривает")
Rel(artist, web_browser, "управляет контентом")
Rel(admin, web_browser, "администрирует")

Rel(web_browser, spring_web, "HTTP/HTTPS запросы")
Rel(spring_web, mysql_db, "JDBC запросы", "query/update")
Rel(spring_web, minio, "REST API", "S3-compatible")
Rel(spring_web, ml_service, "HTTP запросы", "получение рекомендаций")
Rel(spring_web, yandex_vision_api, "HTTP REST API", "анализ изображений для модерации")
Rel(ml_service, ml_engine, "Вызов Python-скриптов", "обучение модели")

@enduml